{
  "schemaVersion": 1,
  "name": "Team invoices",
  "source": {
    "entry": "server.js",
    "paths": [
      "server.js",
      "views/login.js",
      "views/invoices.js",
      "views/layout.js",
      "data/invoices.json",
      "data/users.json",
      "public/style.css",
      "package.json",
      "package-lock.json"
    ]
  },
  "setup": [
    [
      "npm",
      "install"
    ]
  ],
  "start": [
    "node",
    "server.js"
  ],
  "ready": {
    "path": "/login",
    "status": 200
  },
  "capture": {
    "name": "Sign in as Ada",
    "path": "/login",
    "ready": [
      {
        "kind": "wait-selector",
        "selector": "#password"
      },
      {
        "kind": "fill",
        "selector": "#username",
        "value": "ada"
      },
      {
        "kind": "fill",
        "selector": "#password",
        "value": {
          "env": "DEMO_PASSWORD"
        }
      },
      {
        "kind": "click-role",
        "role": "button",
        "name": "Sign in"
      },
      {
        "kind": "wait-text",
        "text": "Signed in as Ada Lovelace"
      },
      {
        "kind": "wait-text",
        "text": "INV-1041"
      },
      {
        "kind": "network-idle"
      }
    ],
    "steps": [
      {
        "kind": "navigate",
        "path": "/invoices"
      },
      {
        "kind": "wait-text",
        "text": "Signed in as Ada Lovelace"
      },
      {
        "kind": "wait-text",
        "text": "INV-1041"
      },
      {
        "kind": "network-idle"
      }
    ],
    "check": {
      "kind": "text",
      "id": "signed-in-as-ada",
      "name": "Signed in as Ada",
      "scope": "Invoices page after signing in as ada.",
      "selector": "header p",
      "expectedText": "Signed in as Ada Lovelace"
    }
  }
}
