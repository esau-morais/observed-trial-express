{
  "schemaVersion": 1,
  "name": "Invoice summary gate 3",
  "source": {
    "entry": "server.js",
    "paths": [
      "server.js",
      "views/login.js",
      "views/invoices.js",
      "views/layout.js",
      "data/invoices.json",
      "data/users.json",
      "public/style.css",
      "package.json",
      "public/gate-3.html",
      "public/gate-3-error.js",
      "public/gate-3-data.js",
      "public/gate-3-error.js.map",
      "public/gate-3-data.js.map",
      "bun.lock"
    ]
  },
  "setup": [
    [
      "bun",
      "install",
      "--frozen-lockfile"
    ]
  ],
  "start": [
    "node",
    "server.js"
  ],
  "ready": {
    "path": "/login",
    "status": 200
  },
  "capture": {
    "name": "Open invoice summary",
    "path": "/gate-3.html",
    "ready": [
      {
        "kind": "wait-text",
        "text": "One invoice is ready"
      }
    ],
    "steps": [
      {
        "kind": "network-idle"
      }
    ],
    "check": {
      "kind": "text",
      "id": "summary",
      "name": "One invoice is ready",
      "scope": "The invoice summary page",
      "selector": "#saved",
      "expectedText": "One invoice is ready"
    },
    "browserArguments": [
      "--no-sandbox"
    ]
  }
}
