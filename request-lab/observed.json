{
  "schemaVersion": 1,
  "name": "Request lab",
  "source": {
    "entry": "server.ts",
    "paths": [
      "App.tsx",
      "base.ts",
      "main.tsx",
      "items.ts",
      "index.html",
      "style.css",
      "tokens.stylex.ts",
      "build.ts",
      "server.ts",
      "package.json",
      "bun.lock",
      "duplicate.ts"
    ]
  },
  "setup": [
    [
      "bun",
      "install",
      "--frozen-lockfile"
    ],
    [
      "bun",
      "run",
      "build"
    ]
  ],
  "start": [
    "bun",
    "run",
    "start"
  ],
  "ready": {
    "path": "/",
    "status": 200
  },
  "capture": {
    "name": "Load items",
    "path": "/",
    "ready": [
      {
        "kind": "wait-text",
        "text": "Load items"
      },
      {
        "kind": "network-idle"
      }
    ],
    "steps": [
      {
        "kind": "click-role",
        "role": "button",
        "name": "Load items"
      },
      {
        "kind": "wait-text",
        "text": "Items loaded"
      },
      {
        "kind": "network-idle"
      }
    ],
    "checks": [
      {
        "kind": "accessibility",
        "id": "no-new-critical-violations",
        "name": "Load items adds no critical accessibility violation",
        "scope": "The page after one Load items click.",
        "impact": "critical"
      }
    ],
    "browserArguments": [
      "--no-sandbox"
    ],
    "viewport": {
      "width": 1120,
      "height": 800,
      "scale": 1
    }
  }
}
